# Python virtual environment
.venv/
venv/
ENV/
env/

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
*.egg-info/
dist/
build/
*.egg

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# Environment variables & secrets
.env
.env.local
.env.*.local
!.env.example

# Node / Frontend
node_modules/
frontend/dist/
frontend/.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Raw data & Master Excel files (strictly excluded from version control)
[Dd]ata/raw/*
![Dd]ata/raw/.gitkeep
[Dd]ata/reference/*
![Dd]ata/reference/.gitkeep
[Dd]ata/processed/*
![Dd]ata/processed/.gitkeep

# Excel temporary / lock files
~$*.xlsx
~$*.xls
~$*.csv

# IDE & Editor files
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
Thumbs.db
Desktop.ini

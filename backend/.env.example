# Copy to backend/.env and adjust. Never commit the real .env file.

# --- Django -----------------------------------------------------------------
# DEBUG defaults to False. Keep True only on a developer machine.
DEBUG=True
# Required when DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- CORS (Vite dev server) -------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Reporting data ---------------------------------------------------------
# Folder containing raw/ and processed/. Defaults to <repo>/Data.
# DATA_DIR=C:\path\to\Data
# The Master workbook is uploaded through the UI (Master workbook page). Accepted uploads
# and the pointer to the active one are kept here (default Data/processed/workbooks):
# WORKBOOK_STORE_DIR=C:\path\to\Data\processed\workbooks
# MAX_WORKBOOK_BYTES=52428800
# Optional fallback used only while nothing has been uploaded (e.g. scripted environments):
# MASTER_WORKBOOK_PATH=C:\path\to\Master.xlsx
# Where uploaded raw files are stored (defaults to Data/raw) and the upload size limit.
# RAW_UPLOAD_DIR=C:\path\to\Data\raw
# MAX_UPLOAD_BYTES=26214400

--- Database ---------------------------------------------------------------
# No current feature stores data in the database; SQLite is the default.
# PostgreSQL (planned for processing history and multi-user features):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=4G-DB
# DB_USER=bsnl_portal_app
# DB_PASSWORD=<set in backend/.env only; never commit it>
# DB_HOST=127.0.0.1
# DB_PORT=5432

# --- Email ------------------------------------------------------------------
# Default: console backend = TEST MODE. Emails are printed in the backend terminal; nothing is delivered.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DEFAULT_FROM_EMAIL=bsnl-reporting@localhost
# EMAIL_TIMEOUT=20
# Real sending (Microsoft Graph for the company Microsoft 365 mailbox) is not implemented yet,
# and live sending also needs sign-in, which the portal does not have yet.

# --- Sign-in and security (see docs/security.md) ----------------------------
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SESSION_IDLE_MINUTES=30
# SESSION_COOKIE_SAMESITE=Lax
# LOGIN_RATE_PER_USER=5/min
# LOGIN_RATE_PER_IP=20/min
# AUDIT_LOG_FILE=C:\path\to\audit.log
# Production only (applied when DEBUG=False):
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# TRUST_X_FORWARDED_PROTO=False
